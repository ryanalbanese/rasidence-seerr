# Integrated with rasidence-fe on the same origin: serve rasidence-fe's built `sw.js` at this URL
# (default `/sw.js`) and enable so Seerr does not register `public/sw.js` under `/request`.
NEXT_PUBLIC_USE_PARENT_SERVICE_WORKER=
# Optional override when the parent PWA script is not at `/sw.js`
# NEXT_PUBLIC_PARENT_SW_URL=/sw.js
